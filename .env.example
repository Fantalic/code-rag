# =============================================================================
# CodeLightRAG — Environment Configuration
# =============================================================================
# Copy to .env and customize. All vars are optional; defaults shown in comments.

# --- Server ---
LIGHTRAG_HOST=0.0.0.0
LIGHTRAG_PORT=9621
LIGHTRAG_API_KEY=
LIGHTRAG_SSL=false
LIGHTRAG_SSL_CERTFILE=
LIGHTRAG_SSL_KEYFILE=
LIGHTRAG_WORKERS=2
LIGHTRAG_TIMEOUT=300
LIGHTRAG_URL=http://localhost:9621

# --- Working directories ---
LIGHTRAG_WORKING_DIR=./rag_storage
LIGHTRAG_INPUT_DIR=./inputs

# --- LLM (Ollama defaults) ---
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=mistral-nemo:latest
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024

# --- RAG tuning ---
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
TOP_K=60
CHUNK_TOP_K=10
MAX_GRAPH_NODES=1000

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
VERBOSE=false

# --- Watchdog ---
WATCHER_INPUT_DIR=./rag_input
WATCHER_DEBOUNCE_SECONDS=0.5
WATCHER_WORKERS=4

# --- Authentication (optional) ---
AUTH_ACCOUNTS=
TOKEN_SECRET=lightrag-jwt-default-secret
JWT_ALGORITHM=HS256
