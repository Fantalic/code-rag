# =============================================================================
# coderag-mcp — Environment Configuration
# =============================================================================
# Copy to .env and customize. Default connects to Docker LightRAG on :9621.
#
# Quick start (Docker):
#   docker compose up -d                        # starts LightRAG on :9621
#   python -m coderag_mcp                        # connects to localhost:9621
#
# Standalone (no Docker):
#   LIGHTRAG_BASE_URL=http://my-server:9621     # override in .env or env var
# =============================================================================

# LightRAG server URL (default: http://localhost:9621 → Docker container)
# Set to a different URL to use a standalone LightRAG instance.
# LIGHTRAG_BASE_URL=http://localhost:9621

# Log level: DEBUG, INFO (default), WARNING, ERROR
# LOG_LEVEL=INFO
